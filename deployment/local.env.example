# Copy this file to a host-local path outside the repository, then edit it for
# the Mac that will run the server. Do not commit secrets or machine-specific
# absolute paths derived from this template.

# Choose exactly one converted-weight source.
IRODORI_MLX_WEIGHTS_DIR=/opt/irodori-models/voicedesign-v2
# IRODORI_MLX_WEIGHTS_REPO=t0yohei/Irodori-TTS-MLX-500M-v2-VoiceDesign
# IRODORI_MLX_WEIGHTS_REVISION=main

# Fail fast at service startup instead of on the first speech request.
IRODORI_MLX_PRELOAD=1

# Local OpenAI-compatible model and codec defaults.
IRODORI_MLX_MODEL_ID=irodori-tts-mlx
IRODORI_MLX_TEXT_MAX_LENGTH=256
IRODORI_MLX_CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
# Used by the default MLX DACVAE runtime when IRODORI_MLX_CODEC_PATH is unset.
IRODORI_MLX_CODEC_ARTIFACT_REPO=t0yohei/Irodori-TTS-MLX-DACVAE-Codec
# Optional local override for the MLX DACVAE codec artifact.
# IRODORI_MLX_CODEC_PATH=/opt/irodori-models/semantic-dacvae-mlx.npz
IRODORI_MLX_CODEC_DEVICE=cpu
IRODORI_MLX_CODEC_RUNTIME_MODE=mlx

# Auth and local request controls.
# Prefer loading the bearer token from macOS Keychain in the launch wrapper.
# IRODORI_SERVER_BEARER_TOKEN=replace-with-a-local-secret
# IRODORI_API_KEY=replace-with-a-local-secret
IRODORI_SERVER_MAX_CONCURRENT_SYNTHESIS=1
IRODORI_SERVER_QUEUE_TIMEOUT_SECONDS=60
IRODORI_SERVER_VOICES_DIR=/opt/irodori-tts-mlx-data/voices
IRODORI_SERVER_MAX_VOICE_UPLOAD_BYTES=52428800
